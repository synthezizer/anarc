---
/** Contact links as a two-column cell grid. Inert placeholders until filled in. */
import Panel from './Panel.astro';
import Icon from '@/components/ui/Icon.astro';
import { iconForHref } from '@/lib/link-icon';
import { contact, site } from '@/site.config';

const placeholders = ['send message', 'add as friend', 'instant message', 'add to favorites'];
---

<Panel title={`contacting ${site.name}`} id="contact">
  {
    contact.length > 0 ? (
      <ul class="cells">
        {contact.map((link) => (
          <li>
            <a
              href={link.href}
              rel="me noopener"
              target={link.href.startsWith('http') ? '_blank' : undefined}
              aria-label={link.label}
              title={link.label}
            >
              <Icon icon={iconForHref(link.href)} />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <>
        <ul class="cells" aria-hidden="true">
          {placeholders.map((label) => (
            <li>
              <span>{label}</span>
            </li>
          ))}
        </ul>
        <p class="note">contact links go in site.config.ts</p>
      </>
    )
  }
</Panel>

<style>
  .cells {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .cells a,
  .cells span {
    display: block;
    padding: 0.45rem 0.5rem;
    background: var(--chip-bg);
    border: 1px solid var(--panel-line);
    border-radius: var(--panel-radius);
    color: var(--chip-ink);
    font-size: var(--text-xs);
  }

  /* Logo only: the icon speaks for itself */
  .cells a {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .cells a:hover {
    background: var(--head-bg);
    color: var(--head-ink);
  }

  .cells span {
    color: var(--panel-muted);
  }

  .note {
    margin-top: 0.5rem;
    color: var(--panel-muted);
    font-size: var(--text-xs);
    font-style: italic;
  }
</style>
