---
/**
 * "andy's beats": an Aero media player. Behaviour lives in src/player/index.ts.
 * It persists across tab switches, so playback never stops while browsing.
 */
import { faSpotify } from '@fortawesome/free-brands-svg-icons';
import { faBackwardStep, faForwardStep, faPause, faPlay, faVolumeHigh } from '@fortawesome/free-solid-svg-icons';
import Panel from '@/components/panels/Panel.astro';
import Icon from '@/components/ui/Icon.astro';
import { getBeats } from '@/lib/beats';
import { music, site } from '@/site.config';
const beats = await getBeats();
---

<div class="beats" transition:persist="beat-player">
  <Panel title="vault" count={beats.length} action={{ label: 'Spotify', href: music.spotify, icon: faSpotify, iconOnly: true }} fixed>
    {
      beats.length === 0 ? (
        <p class="empty">beats go here: drop .mp3 / .wav / .m4a files into src/assets/beats/</p>
      ) : (
        <div class="player" data-player data-artist={site.name}>
          <div class="screen">
            <canvas class="viz" data-viz aria-hidden="true"></canvas>
            <div class="now">
              <p class="track" data-title aria-live="polite">{beats[0]?.title}</p>
              <p class="time">
                <span data-current>0:00</span> / <span data-duration>--:--</span>
              </p>
            </div>
          </div>

          <input
            class="seek"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            aria-label="Seek"
            data-seek
          />

          <div class="controls">
            <button class="round" type="button" aria-label="Previous beat" data-prev>
              <Icon icon={faBackwardStep} />
            </button>
            <button class="orb candy" type="button" aria-label="Play" data-toggle>
              <span class="icon-play"><Icon icon={faPlay} /></span>
              <span class="icon-pause"><Icon icon={faPause} /></span>
            </button>
            <button class="round" type="button" aria-label="Next beat" data-next>
              <Icon icon={faForwardStep} />
            </button>
            <label class="volume">
              <span class="visually-hidden">Volume</span>
              <Icon icon={faVolumeHigh} class="vol-icon" />
              <input type="range" min="0" max="1" step="0.01" value="0.85" data-volume />
            </label>
          </div>

          <ol class="list">
            {
              beats.map((beat, i) => (
                <li>
                  <button type="button" data-track={i} data-src={beat.src} data-cover={beat.cover}>
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="name">{beat.title}</span>
                    <span class="len" data-length>--:--</span>
                  </button>
                </li>
              ))
            }
          </ol>

          <audio preload="none" data-audio></audio>
        </div>
      )
    }
  </Panel>
</div>

<script>
  import { startPlayer } from '@/player';
  startPlayer();
</script>

<style>
  .empty {
    color: var(--panel-muted);
    font-size: var(--text-xs);
    font-style: italic;
  }

  .player {
    display: grid;
    gap: 0.6rem;
  }

  /* Glossy dark "now playing" screen with the visualizer behind the text */
  .screen {
    position: relative;
    height: 5.5rem;
    overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(180deg, #0b3d6e 0%, #062748 100%);
    box-shadow:
      inset 0 0 0 1px rgb(0 20 40 / 0.6),
      inset 0 2px 6px rgb(0 0 0 / 0.4);
  }

  .screen::after {
    content: '';
    position: absolute;
    inset: 0 0 55%;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.02));
    pointer-events: none;
  }

  .viz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .now {
    position: relative;
    display: grid;
    align-content: end;
    height: 100%;
    padding: 0.5rem 0.65rem;
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  .track {
    font-family: var(--font-pixel);
    overflow: hidden;
    font-size: var(--text-s);
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .time {
    font-family: var(--font-pixel);
    color: #9fe0ff;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  /* Range inputs: glass groove, aqua gloss fill via --fill, glossy thumb */
  input[type='range'] {
    --fill: 0%;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background:
      linear-gradient(90deg, #2ea7e6 0 var(--fill), transparent var(--fill)),
      linear-gradient(180deg, rgb(0 40 80 / 0.25), rgb(255 255 255 / 0.6));
    box-shadow: inset 0 0 0 1px var(--panel-line);
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0 25%, #6fd1fb 55%, #1689cf 100%);
    box-shadow: 0 0 0 1px var(--pill-edge), 0 1px 3px rgb(0 40 90 / 0.4);
  }

  input[type='range']::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0 25%, #6fd1fb 55%, #1689cf 100%);
    box-shadow: 0 0 0 1px var(--pill-edge);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  button {
    font: inherit;
    cursor: pointer;
  }

  .round,
  .orb {
    display: grid;
    place-items: center;
    border-radius: 50%;
    transition:
      transform var(--dur-fast) var(--ease-out),
      filter var(--dur-fast) var(--ease-out);
  }

  .round {
    width: 2rem;
    height: 2rem;
    background: var(--chip-bg);
    border: 1px solid var(--panel-line);
    box-shadow: inset 0 1px 0 #fff;
  }

  /* The big WMP-style play orb */
  .orb {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
  }

  .round:hover,
  .orb:hover {
    filter: brightness(1.08);
  }

  .round:active,
  .orb:active {
    transform: scale(0.94);
  }

  .round {
    color: var(--chip-ink);
    font-size: 0.75rem;
  }

  /* White glyph on the aqua orb; nudge play right so it looks centred */
  .orb {
    color: #fff;
    font-size: 1rem;
    filter: drop-shadow(0 1px 1px rgb(0 50 100 / 0.5));
  }

  .icon-play {
    translate: 1px 0;
  }


  .icon-play,
  .is-playing .icon-pause {
    display: grid;
  }

  .icon-pause,
  .is-playing .icon-play {
    display: none;
  }

  .volume {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.25rem;
  }

  .volume {
    color: var(--chip-ink);
    font-size: 0.75rem;
  }

  .list {
    display: grid;
    gap: 2px;
    max-height: 12rem;
    overflow-y: auto;
    padding: 0;
    list-style: none;
  }

  .list button {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    padding: 0.35rem 0.5rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--panel-ink);
    font-size: var(--text-xs);
    text-align: left;
  }

  .list button:hover {
    background: var(--chip-bg);
    border-color: var(--panel-line);
  }

  .list button[aria-current='true'] {
    background: var(--pill-bg);
    border-color: var(--pill-edge);
    color: var(--pill-ink);
    text-shadow: var(--pill-ink-shadow);
  }

  .num,
  .len {
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  .name {
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
