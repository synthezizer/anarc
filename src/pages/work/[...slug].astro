---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileShell from '@/components/shell/ProfileShell.astro';
import Panel from '@/components/panels/Panel.astro';
import { faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import Icon from '@/components/ui/Icon.astro';
import { iconForHref } from '@/lib/link-icon';
import { formatDate, getWork, type WorkEntry } from '@/lib/work';

export async function getStaticPaths() {
  const entries = await getWork();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const { title, summary, date, tags, cover, coverAlt, links } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <ProfileShell tab="work">
    <Panel title={title} action={{ label: '← all work', href: '/work' }} fixed>
      <article class="post">
        <p class="meta">
          posted <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {tags.length > 0 && <span> · {tags.join(', ')}</span>}
        </p>
        <h1 class="name-face">{title}</h1>
        <p class="summary">{summary}</p>
        {
          cover ? (
            <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[640, 1100, 1600]} sizes="(min-width: 68rem) 40rem, 100vw" />
          ) : (
            <div class="cover placeholder" aria-hidden="true">
              <span>cover image</span>
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
        {
          links.length > 0 && (
            <ul class="links">
              {links.map((link) => (
                <li>
                  <a href={link.href} rel="noopener" target="_blank">
                    <Icon icon={iconForHref(link.href)} /> {link.label} <Icon icon={faArrowUpRightFromSquare} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </article>
    </Panel>
  </ProfileShell>
</BaseLayout>

<style>
  .post {
    display: grid;
    gap: var(--space-s);
  }

  .meta {
    color: var(--panel-muted);
    font-size: var(--text-xs);
  }

  h1 {
    color: var(--panel-ink);
    font-size: calc(var(--headline) * var(--name-scale));
    line-height: 1;
  }

  .summary {
    max-width: 48ch;
    font-size: var(--text-m);
    font-weight: 700;
  }

  .cover {
    width: 100%;
    border: 1px solid var(--panel-line);
    border-radius: var(--panel-radius);
  }

  .placeholder {
    display: grid;
    place-items: end start;
    aspect-ratio: 16 / 10;
    padding: 0.6rem;
    background: var(--tile-bg);
    color: var(--tile-ink);
    font-size: var(--text-xs);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
    font-size: var(--text-s);
  }
</style>
